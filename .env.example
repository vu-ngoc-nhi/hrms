# ---- Environment ----
# local | test | production. The development test identity works only when APP_ENV is local/test AND NODE_ENV != production.
# Tests require APP_ENV=test from the shell (`npm test` sets it); this file never makes the test database resettable.
APP_ENV=local

# ---- Database (local docker-compose, 127.0.0.1:55432) ----
# hrms_local_dev_only is a PUBLIC, disposable development-only password (see docker-compose.yml).
# It is NOT a secret. Never reuse it, or this file's values, for staging or production.
# The app runs as hrms_app (no DDL, cannot modify or delete audit rows).
DATABASE_URL=postgresql://hrms_app:hrms_local_dev_only@127.0.0.1:55432/hrms_dev
# Migrations run as the schema owner. `npm run db:migrate` refuses non-local targets.
MIGRATION_DATABASE_URL=postgresql://hrms_owner:hrms_local_dev_only@127.0.0.1:55432/hrms_dev
TEST_DATABASE_URL=postgresql://hrms_app:hrms_local_dev_only@127.0.0.1:55432/hrms_test
TEST_MIGRATION_DATABASE_URL=postgresql://hrms_owner:hrms_local_dev_only@127.0.0.1:55432/hrms_test

# ---- Authentication ----
# test  = local development test issuer (HS256). NOT Microsoft Entra ID. Blocked in production.
# entra = Microsoft Entra ID access tokens for the HRMS API registration.
AUTH_MODE=test
AUTH_TEST_ISSUER_ENABLED=true
# Generate with: openssl rand -base64 48
AUTH_TEST_ISSUER_SECRET=

# API app registration (provided by EmeSoft IT / Entra Administrator; Pending IT configuration). Leave empty until available.
# The API registration must set api.requestedAccessTokenVersion = 2 (Microsoft Graph manifest format; null means v1).
# Only v2 access tokens are accepted, and their `aud` must equal ENTRA_API_CLIENT_ID.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# Delegated scope name exposed by the API (App ID URI api://<ENTRA_API_CLIENT_ID>, used by the SPA to request it)
ENTRA_API_SCOPE=access_as_user

# Web/SPA app registration (separate from the API registration). Reserved for the MSAL sign-in flow (not implemented yet).
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_SPA_CLIENT_ID=
# Full scope requested by the SPA, e.g. api://<HRMS_API_CLIENT_ID>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=

# ---- Other ----
# HMAC key for idempotency fingerprints (openssl rand -base64 32)
IDEMPOTENCY_HMAC_KEY=
# Accepted company email domains, comma-separated (synthetic data uses example.test)
COMPANY_EMAIL_DOMAINS=example.test
